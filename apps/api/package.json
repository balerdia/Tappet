{
  "name": "@tappet/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "TAPPET_DEV_AUTH=${TAPPET_DEV_AUTH:-auto} DATABASE_PATH=../../data/tappet.sqlite tsx watch --env-file-if-exists=../../.env src/node.ts",
    "start": "tsx src/node.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@clerk/backend": "3.23.2",
    "@hono/node-server": "^2.1.5",
    "@tappet/connectors": "workspace:*",
    "@tappet/db": "workspace:*",
    "@tappet/workflow": "workspace:*",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "tsx": "^4.23.15",
    "wrangler": "^4.152.0"
  }
}
