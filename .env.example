# Copy to .env and fill in. `pnpm dev` reads it for both the API and the web app.
# Leave the Clerk keys empty to use the built-in development user instead of sign-in.

# Clerk (dashboard.clerk.com → API keys). Set both or neither.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Encrypts stored app tokens. Generate with: openssl rand -base64 32
CREDENTIALS_KEY=

# Linear OAuth app (linear.app/settings/api/applications).
# Callback URL to register: http://localhost:5173/api/connections/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Where the web app runs. Locally that's the Vite dev server.
APP_URL=http://localhost:5173
