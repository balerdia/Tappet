{
  "name": "tappet",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tappet/api --filter @tappet/web dev",
    "dev:api": "pnpm --filter @tappet/api dev",
    "dev:web": "pnpm --filter @tappet/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @tappet/db generate",
    "db:migrate": "pnpm --filter @tappet/db migrate"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
